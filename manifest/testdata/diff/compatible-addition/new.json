{
  "hearth": 1,
  "app": "marks",
  "version": "1.3.0",
  "capabilities": [
    "marks:export",
    "marks:read",
    "marks:write"
  ],
  "selectors": [
    "folder"
  ],
  "operations": [
    {
      "name": "frostyard.frostmarks.v1.Marks.ExportBookmarks",
      "permission": "marks:export",
      "effect": "outward",
      "expose": [
        "ui"
      ],
      "selectors": []
    },
    {
      "name": "frostyard.frostmarks.v1.Marks.GetBookmark",
      "permission": "marks:read",
      "effect": "read",
      "expose": [
        "ui"
      ],
      "selectors": []
    },
    {
      "name": "frostyard.frostmarks.v1.Marks.ListBookmarks",
      "permission": "marks:read",
      "effect": "read",
      "expose": [
        "ui",
        "agent"
      ],
      "selectors": [
        {
          "field": "folder.name",
          "selector": "folder"
        }
      ],
      "tool": "list_bookmarks"
    },
    {
      "name": "frostyard.frostmarks.v1.Marks.CreateBookmark",
      "permission": "marks:write",
      "effect": "write",
      "expose": [
        "ui",
        "agent"
      ],
      "selectors": [
        {
          "field": "folder.name",
          "selector": "folder"
        }
      ],
      "tool": "create_bookmark"
    }
  ],
  "events": [
    {
      "type": "org.frostyard.marks.bookmark.created",
      "message": "frostyard.frostmarks.v1.BookmarkCreated",
      "topic": "marks.bookmark.created.folder",
      "selector": "folder",
      "read_permission": "marks:read"
    },
    {
      "type": "org.frostyard.marks.bookmarks.exported",
      "message": "frostyard.frostmarks.v1.BookmarksExported",
      "topic": "marks.bookmarks.exported",
      "read_permission": "marks:export"
    },
    {
      "type": "org.frostyard.marks.bookmark.moved",
      "message": "frostyard.frostmarks.v1.BookmarkMoved",
      "topic": "marks.bookmark.moved.folder",
      "selector": "folder",
      "read_permission": "marks:read"
    }
  ]
}
