{
  "schema_version": 1,
  "default_decision": "deny",
  "actions": {
    "read": "allow",
    "write": "allow",
    "run-tests": "allow",
    "open-issue": "review-required",
    "open-pr": "review-required"
  },
  "protected_boundaries": [
    {
      "id": "workflow-and-permissions",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".github/workflows/**",
        ".github/risk-paths.json",
        "policies/**",
        "Makefile",
        "internal/workflowcheck/**",
        "internal/repocheck/**",
        "internal/cmd/corrections-base/**"
      ],
      "detectors": []
    },
    {
      "id": "release-and-publication",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".svu.yml",
        ".goreleaser.yaml",
        ".github/workflows/release.yml",
        "packaging/**"
      ],
      "detectors": []
    },
    {
      "id": "permission-generation-and-checks",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "proto/frostyard/hearth/v1/options.proto",
        "internal/model/**",
        "cmd/protoc-gen-hearth-authz/**",
        "authz/**",
        "lodge/**",
        "cmd/protoc-gen-hearth-manifest",
        "manifest",
        "schema"
      ],
      "detectors": []
    },
    {
      "id": "supply-chain",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "mise.toml",
        "mise.lock",
        "go.mod",
        "go.sum",
        "buf.yaml",
        "buf.lock",
        "buf.gen.yaml"
      ],
      "detectors": []
    }
  ],
  "change_controls": {
    "pull_requests_required": true,
    "human_review_before_merge": true,
    "highest_applicable_risk": true,
    "validation_evidence_required": true,
    "least_privilege": true,
    "untrusted_content_is_data": true,
    "never_relax": [
      "required-checks",
      "security-checks",
      "review-requirements",
      "coverage-checks",
      "provenance-verification"
    ]
  },
  "exception_controls": {
    "independent_authorized_approver": true,
    "self_approval": false,
    "required_fields": [
      "rationale",
      "target",
      "compensating-controls",
      "expires-at",
      "restoration-or-closure-plan"
    ]
  },
  "risk_classification": {
    "tiers": [
      "low",
      "moderate",
      "high",
      "critical"
    ],
    "classification_rule": "highest-applicable",
    "uncertainty_rule": "higher-plausible"
  }
}
